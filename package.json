{
  "name": "dsh-sound-cue",
  "version": "0.2.0",
  "description": "DSH sound cues: a short Web Audio ding when you need to act (approval / question / plan review), and a different one when a task finishes. Works on DSH 0.1.7+ (desktop & web) and on 0.1.0-rc.6 web. 需要操作与任务完成时的简短提示音（Web Audio 合成，无弹窗无系统通知）。",
  "private": false,
  "type": "module",
  "main": "./lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "docs/"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "plugin",
    "sound",
    "notification",
    "audio",
    "web-audio"
  ],
  "license": "BSD-3-Clause",
  "homepage": "https://github.com/Nixz0824/dsh-sound-cue#readme",
  "bugs": {
    "url": "https://github.com/Nixz0824/dsh-sound-cue/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nixz0824/dsh-sound-cue.git"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js",
    "smoke": "node scripts/smoke-client.mjs",
    "test:client": "node scripts/test-client.mjs",
    "sounds": "python scripts/gen-preview-sounds.py",
    "pack": "npm pack",
    "test": "npm run check && npm run smoke && npm run test:client"
  },
  "dsh": {
    "client": {
      "inject": [],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
